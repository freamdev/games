      tabTownBtn.setAttribute("aria-selected", String(isTown));
      tabTalentsBtn.setAttribute("aria-selected", String(!isTown));

      tabTownBtn.tabIndex = isTown ? 0 : -1;
      tabTalentsBtn.tabIndex = !isTown ? 0 : -1;

      tabTown.hidden = !isTown;
      tabTalents.hidden = isTown;

      tabHint.textContent = isTown
        ? "Town: upgrade buildings • timers & gains affected by levels"
        : "Talents: static skill tree (visual only)";

      state.activeRightTab = tabName;
      saveState();
