<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Party + Town/Talents Tabs</title>
  <style>
    :root{
      --bg:#0b0f14;
      --border:#243244;
      --text:#e8eef7;
      --muted:#aab6c5;
      --shadow: 0 10px 30px rgba(0,0,0,.35);
      --radius:16px;

      --good:#7cc4ff;
      --bad:#ff7c7c;
      --gold:#ffd27a;
      --wood:#9be39b;

      --panelA: rgba(16,24,35,.92);
      --panelB: rgba(15,22,32,.92);
      --card: rgba(255,255,255,.02);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: radial-gradient(1200px 700px at 30% 10%, #132238 0%, var(--bg) 60%);
      color:var(--text);
      height:100vh;
      overflow:hidden;
    }

    .layout{
      display:flex;
      height:100vh;
      width:100vw;
    }

    /* Left tab (30%) */
    .leftTab{
      width:30vw;
      min-width:360px;
      max-width:520px;
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.01));
      border-right:1px solid var(--border);
      padding:16px;
      display:flex;
      flex-direction:column;
      gap:12px;
      box-shadow: var(--shadow);
    }
    .tabHeader{
      display:flex;
      flex-direction:column;
      gap:10px;
      padding:14px 14px;
      border:1px solid var(--border);
      border-radius: var(--radius);
      background: var(--panelA);
    }
    .headerTop{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:12px;
    }
    .tabHeader h1{
      font-size:14px;
      margin:0;
      letter-spacing:.5px;
      text-transform:uppercase;
      color:var(--muted);
    }
    .hint{
      font-size:12px;
      color:var(--muted);
      margin:0;
      line-height:1.3;
      text-align:right;
    }

    .timers{
      display:grid;
      grid-template-columns: 1fr;
      gap:10px;
    }
    .timerCard{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
      border-radius:14px;
      padding:10px 10px;
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .timerTop{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      font-size:12px;
      color:var(--muted);
    }
    .timerTop b{ color:var(--text); font-weight:900; }
    .bar{
      height:10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.22);
      overflow:hidden;
    }
    .barFill{
      height:100%;
      width:0%;
      background: rgba(124,196,255,.9);
      transition: width .10s linear;
    }
    .barFill.loot{ background: rgba(255,210,122,.85); }
    .barFill.gather{ background: rgba(155,227,155,.85); }

    .rows{
      flex:1;
      overflow:auto;
      padding-right:6px;
    }
    .rows::-webkit-scrollbar{ width:10px; }
    .rows::-webkit-scrollbar-thumb{
      background: rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.10);
      border-radius:999px;
    }

    .rowCard{
      border:1px solid var(--border);
      background: linear-gradient(180deg, rgba(16,24,35,.9), rgba(15,22,32,.9));
      border-radius: var(--radius);
      padding:12px;
      margin-bottom:12px;
      display:grid;
      grid-template-columns: 1fr 140px;
      gap:12px;
      align-items:stretch;
    }
    .rowLeft{
      display:flex;
      flex-direction:column;
      gap:10px;
      min-width:0;
    }
    .rowTitle{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }
    .rowTitle .name{
      font-weight:950;
      font-size:13px;
      color:var(--text);
      opacity:.95;
    }
    .rowTitle .meta{
      font-size:12px;
      color:var(--muted);
      white-space:nowrap;
    }

    .bigIcons{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:10px;
    }
    .iconTile{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      border-radius:14px;
      padding:10px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:6px;
      min-height:86px;
    }
    .iconTile svg{
      width:46px;
      height:46px;
      filter: drop-shadow(0 6px 10px rgba(0,0,0,.35));
    }
    .iconLabel{
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.6px;
    }

    .gearRow{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      align-items:center;
    }
    .gearSlot{
      width:34px;
      height:34px;
      border-radius:10px;
      border:1px dashed rgba(255,255,255,.18);
      background: rgba(0,0,0,.12);
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      transition: transform .08s ease, border-color .12s ease, background .12s ease;
      user-select:none;
    }
    .gearSlot:hover{
      transform: translateY(-1px);
      border-color: rgba(255,255,255,.28);
      background: rgba(255,255,255,.04);
    }
    .gearSlot svg{ width:20px; height:20px; opacity:.95; }
    .gearSlot[data-gear="empty"] svg{ display:none; }
    .gearLegend{
      margin-left:auto;
      font-size:11px;
      color:var(--muted);
      white-space:nowrap;
    }

    /* --- Right side of each party row --- */
    .rowRight{
      border-left:1px solid rgba(255,255,255,.08);
      padding-left:12px;
      display:flex;
      flex-direction:column;
      justify-content:flex-start;
      gap:10px;
    }
    .radioGroup{
      display:flex;
      flex-direction:column;
      gap:8px;
      margin-top:auto; /* push radios down */
    }
    .radioOpt{
      display:flex;
      align-items:center;
      gap:8px;
      font-size:12px;
      color:var(--text);
    }
    .radioOpt input{
      transform: translateY(1px);
      accent-color: var(--good);
    }
    .radioOpt input:disabled + span{
      color: rgba(232,238,247,.35);
    }

    /* --- Task / Enemy Viz --- */
    .taskViz{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
      border-radius:14px;
      padding:10px;
      display:flex;
      align-items:center;
      gap:10px;
      min-height:64px;
    }
    .taskIcon{
      width:44px;
      height:44px;
      border-radius:14px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.03);
      display:flex;
      align-items:center;
      justify-content:center;
      flex:0 0 auto;
    }
    .taskIcon svg{
      width:28px;
      height:28px;
      filter: drop-shadow(0 6px 10px rgba(0,0,0,.35));
    }
    .taskText{
      display:flex;
      flex-direction:column;
      gap:2px;
      min-width:0;
    }
    .taskText .top{
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.6px;
    }
    .taskText .main{
      font-size:12px;
      color:var(--text);
      font-weight:900;
      line-height:1.1;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }

    /* Right side shell */
    .rightMain{
      flex:1;
      padding:18px;
      overflow:auto;
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    /* Top resources always visible */
    .rightHeader{
      position: sticky;
      top: 0;
      z-index: 10;
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:14px;
      border:1px solid rgba(255,255,255,.10);
      border-radius:24px;
      padding:16px 16px;
      background: rgba(11,15,20,.78);
      backdrop-filter: blur(10px);
    }
    .rightHeader h2{
      margin:0 0 6px 0;
      font-size:18px;
    }
    .rightHeader p{
      margin:0;
      color:var(--muted);
      line-height:1.45;
      font-size:13px;
      max-width: 720px;
    }

    .statusPills{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      justify-content:flex-end;
      align-items:flex-start;
    }
    .pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      color:var(--muted);
      font-size:12px;
      white-space:nowrap;
      height:fit-content;
    }
    .pill strong{
      color:var(--text);
      font-weight:950;
      margin-left:2px;
    }
    .pillIcon{
      width:16px;
      height:16px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
    }
    .pillIcon svg{ width:16px; height:16px; }

    .pill button{
      all:unset;
      cursor:pointer;
      padding:6px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.18);
      color:var(--text);
      font-weight:900;
      margin-left:6px;
    }
    .pill button:hover{
      border-color: rgba(255,255,255,.22);
      background: rgba(255,255,255,.04);
    }

    /* Right content tabs */
    .contentCard{
      border:1px solid rgba(255,255,255,.10);
      border-radius:24px;
      background: var(--card);
      padding:14px;
      box-shadow: 0 10px 25px rgba(0,0,0,.18);
    }
    .tabBar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-bottom:12px;
    }
    .tabBtns{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
    }
    .tabBtn{
      all:unset;
      cursor:pointer;
      padding:10px 12px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.20);
      color: var(--muted);
      font-weight:900;
      font-size:12px;
      letter-spacing:.3px;
      text-transform:uppercase;
      transition: border-color .12s ease, background .12s ease, transform .10s ease;
    }
    .tabBtn:hover{
      transform: translateY(-1px);
      border-color: rgba(124,196,255,.35);
      background: rgba(124,196,255,.06);
      color: var(--text);
    }
    .tabBtn.active{
      border-color: rgba(124,196,255,.55);
      background: rgba(124,196,255,.10);
      color: var(--text);
    }
    .tabHint{
      font-size:12px;
      color:var(--muted);
      line-height:1.35;
    }

    /* Town */
    .buildGrid{
      display:grid;
      grid-template-columns: repeat(3, minmax(220px, 1fr));
      gap:14px;
    }
    .building{
      border:1px solid rgba(255,255,255,.10);
      border-radius:24px;
      padding:14px;
      background: linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.01));
      box-shadow: 0 10px 25px rgba(0,0,0,.25);
      display:flex;
      flex-direction:column;
      gap:12px;
      cursor:pointer;
      user-select:none;
      transition: transform .10s ease, border-color .12s ease, background .12s ease;
      min-height:205px;
    }
    .building:hover{
      transform: translateY(-2px);
      border-color: rgba(124,196,255,.35);
      background: linear-gradient(180deg, rgba(124,196,255,.06), rgba(255,255,255,.01));
    }
    .building.locked{
      cursor:not-allowed;
      opacity:.92;
    }
    .building.locked:hover{
      transform:none;
      border-color: rgba(255,124,124,.25);
      background: linear-gradient(180deg, rgba(255,124,124,.04), rgba(255,255,255,.01));
    }

    .bTop{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }
    .bIcon{
      width:54px;
      height:54px;
      border-radius:16px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.18);
      display:flex;
      align-items:center;
      justify-content:center;
      flex:0 0 auto;
    }
    .bIcon svg{
      width:34px;
      height:34px;
      filter: drop-shadow(0 6px 10px rgba(0,0,0,.35));
    }
    .bTitle{
      display:flex;
      flex-direction:column;
      gap:2px;
      min-width:0;
      flex:1;
    }
    .bName{
      font-weight:950;
      letter-spacing:.2px;
      font-size:14px;
      margin:0;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .bSub{
      font-size:12px;
      color:var(--muted);
      margin:0;
      line-height:1.25;
    }
    .bLevel{
      font-size:12px;
      padding:6px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.03);
      color:var(--text);
      font-weight:950;
      white-space:nowrap;
    }
    .bBody{
      display:flex;
      flex-direction:column;
      gap:10px;
      flex:1;
    }
    .barWrap{
      display:flex;
      flex-direction:column;
      gap:6px;
    }
    .barLabel{
      display:flex;
      align-items:center;
      justify-content:space-between;
      font-size:12px;
      color:var(--muted);
    }

    .costLine{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      align-items:center;
      justify-content:space-between;
      margin-top:4px;
      font-size:12px;
      color:var(--muted);
    }
    .costPair{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
    }
    .costItem{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:6px 8px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.16);
      color: var(--text);
      font-weight:950;
    }
    .costItem .sub{
      color:var(--muted);
      font-weight:800;
      margin-left:2px;
    }
    .costItem svg{ width:16px; height:16px; }
    .costItem.gold{ border-color: rgba(255,210,122,.20); }
    .costItem.wood{ border-color: rgba(155,227,155,.20); }

    .cta{
      padding:8px 10px;
      border-radius:14px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.18);
      color:var(--text);
      font-weight:950;
      font-size:12px;
      white-space:nowrap;
    }

    /* Talents */
    .talentWrap{
      border:1px solid rgba(255,255,255,.10);
      border-radius:24px;
      background: linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.01));
      padding:14px;
      overflow:hidden;
    }
    .talentStage{
      width:100%;
      min-height: 560px;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.10);
      background: radial-gradient(900px 520px at 30% 10%, rgba(124,196,255,.07), rgba(0,0,0,.18));
      position:relative;
      overflow:hidden;
    }
    .talentStage svg{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
    }

    /* Toast */
    .toast{
      position:fixed;
      left: calc(30vw + 18px);
      bottom: 16px;
      padding:10px 12px;
      border-radius:16px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.45);
      backdrop-filter: blur(10px);
      color:var(--text);
      font-size:12px;
      box-shadow: var(--shadow);
      opacity:0;
      transform: translateY(6px);
      transition: opacity .16s ease, transform .16s ease;
      pointer-events:none;
      max-width: min(620px, 60vw);
      line-height:1.35;
      z-index: 50;
    }
    .toast.show{ opacity:1; transform: translateY(0); }

    @media (max-width: 1100px){
      .buildGrid{ grid-template-columns: repeat(2, minmax(220px, 1fr)); }
    }
    @media (max-width: 980px){
      body{ overflow:auto; }
      .layout{ flex-direction:column; height:auto; }
      .leftTab{ width:100%; max-width:none; min-width:0; }
      .toast{ left:16px; }
      .buildGrid{ grid-template-columns: 1fr; }
      .statusPills{ justify-content:flex-start; }
      .rightHeader{ position: sticky; top: 0; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <!-- LEFT: always visible -->
    <aside class="leftTab">
      <div class="tabHeader">
        <div class="headerTop">
          <div>
            <h1 style="margin-bottom:6px;">Party</h1>
            <div style="font-size:12px;color:var(--muted);line-height:1.25;">
              <b>Climb</b> increases highest climbed level on its timer.<br/>
              <b>Loot</b>/<b>Gather</b> pay out on their own timers.
            </div>
          </div>
          <p class="hint">
            Gear slots: click to cycle<br/>
            Only one group can be <b>Climb</b>
          </p>
        </div>

        <div class="timers" aria-label="Timers">
          <div class="timerCard">
            <div class="timerTop">
              <span>Climb timer: <b id="climbTimerText">—</b></span>
              <span>Now: <b id="climbTimerSec">—</b>s</span>
            </div>
            <div class="bar"><div id="climbBar" class="barFill"></div></div>
          </div>

          <div class="timerCard">
            <div class="timerTop">
              <span>Loot timer: <b id="lootTimerText">—</b></span>
              <span>Now: <b id="lootTimerSec">—</b>s</span>
            </div>
            <div class="bar"><div id="lootBar" class="barFill loot"></div></div>
          </div>

          <div class="timerCard">
            <div class="timerTop">
              <span>Gather timer: <b id="gatherTimerText">—</b></span>
              <span>Now: <b id="gatherTimerSec">—</b>s</span>
            </div>
            <div class="bar"><div id="gatherBar" class="barFill gather"></div></div>
          </div>
        </div>
      </div>

      <div id="rows" class="rows"></div>
    </aside>

    <!-- RIGHT: resources always visible at top + tabbed content -->
    <main class="rightMain">
      <div class="rightHeader">
        <div>
          <h2>Dashboard</h2>
          <p>
            Top resources stay visible. Use the tabs below to switch between <b>Town</b> and <b>Talents</b>.
          </p>
        </div>

        <div class="statusPills">
          <div class="pill" title="Highest climbed level (increases when climb timer completes)">
            <span class="pillIcon" aria-hidden="true" id="mountainIcon"></span>
            Highest climbed: <strong id="highestClimbed">1</strong>
          </div>

          <div class="pill" title="Gold">
            <span class="pillIcon" aria-hidden="true" id="goldIcon"></span>
            <strong id="goldVal">0</strong>
          </div>

          <div class="pill" title="Wood">
            <span class="pillIcon" aria-hidden="true" id="woodIcon"></span>
            <strong id="woodVal">0</strong>
          </div>

          <div class="pill">
            Total building levels: <strong id="totalLevels">—</strong>
            <button id="resetBtn" type="button" title="Reset all buildings/resources/timers">Reset</button>
          </div>
        </div>
      </div>

      <section class="contentCard" aria-label="Content tabs">
        <div class="tabBar">
          <div class="tabBtns" role="tablist" aria-label="Town and Talents tabs">
            <button class="tabBtn active" id="tabTownBtn" role="tab" aria-selected="true" aria-controls="tabTown" tabindex="0">
              Town
            </button>
            <button class="tabBtn" id="tabTalentsBtn" role="tab" aria-selected="false" aria-controls="tabTalents" tabindex="-1">
              Talents
            </button>
          </div>
          <div class="tabHint" id="tabHint">
            Town: upgrade buildings • Talents: static skill tree
          </div>
        </div>

        <div id="tabTown" role="tabpanel" aria-labelledby="tabTownBtn">
          <div id="buildGrid" class="buildGrid" aria-label="Buildings grid"></div>
        </div>

        <div id="tabTalents" role="tabpanel" aria-labelledby="tabTalentsBtn" hidden>
          <div class="talentWrap">
            <div class="talentStage" aria-label="Static skill tree">
              <svg id="talentSvg" viewBox="0 0 1000 600" xmlns="http://www.w3.org/2000/svg"></svg>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <script>
    // ---------- SVG HELPERS ----------
    function svgIcon(inner, opts = {}){
      const vb = opts.viewBox || "0 0 24 24";
      const sw = opts.strokeWidth || 2;
      const fill = opts.fill || "none";
      return `
        <svg viewBox="${vb}" fill="${fill}" xmlns="http://www.w3.org/2000/svg"
             stroke="currentColor" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round">
          ${inner}
        </svg>
      `;
    }

    // Resource/Status icons
    const ICONS = {
      gold: svgIcon(`
        <path d="M12 3c4.2 0 7 1.6 7 3.5S16.2 10 12 10 5 8.4 5 6.5 7.8 3 12 3z"/>
        <path d="M5 6.5V12c0 1.9 2.8 3.5 7 3.5s7-1.6 7-3.5V6.5" opacity=".65"/>
        <path d="M5 12v5.5c0 1.9 2.8 3.5 7 3.5s7-1.6 7-3.5V12" opacity=".45"/>
      `),
      wood: svgIcon(`
        <path d="M7 21V9c0-3 2-5 5-5s5 2 5 5v12" />
        <path d="M7 14h10" opacity=".6"/>
        <path d="M9 9c.8 1 1.8 1.5 3 1.5S14.2 10 15 9" opacity=".6"/>
        <path d="M11 21v-6" opacity=".5"/>
      `),
      mountain: svgIcon(`
