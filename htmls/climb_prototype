      buildGridEl.innerHTML = "";

      let total = 0;
      for(const b of BUILDINGS){
        const lv = clampInt(state.buildings[b.key], 1, MAX_LEVEL);
        total += lv;

        const pct = levelProgressPercent(lv);
        const isMax = lv >= MAX_LEVEL;
        const cost = isMax ? null : nextUpgradeCost(b.key, lv);
        const affordable = cost ? canAfford(cost) : true;

        const card = document.createElement("div");
        card.className = "building" + ((!affordable && !isMax) ? " locked" : "");
        card.dataset.key = b.key;
        card.setAttribute("role","button");
        card.setAttribute("tabindex","0");

        const costHtml = isMax ? `
          <div class="costLine">
            <span>Max level reached</span>
            <span class="cta">Max</span>
          </div>
        ` : `
          <div class="costLine">
            <div class="costPair">
              <span class="costItem gold">${ICONS.gold}${cost.gold}<span class="sub">g</span></span>
              <span class="costItem wood">${ICONS.wood}${cost.wood}<span class="sub">w</span></span>
            </div>
            <span class="cta">${affordable ? "Click to upgrade" : "Not enough"}</span>
          </div>
        `;

        card.innerHTML = `
          <div class="bTop">
            <div class="bIcon" aria-hidden="true">${BUILDING_ICONS[b.name] || ""}</div>
            <div class="bTitle">
              <p class="bName">${b.name}</p>
              <p class="bSub">${b.desc}</p>
            </div>
            <div class="bLevel">Lvl ${lv}</div>
          </div>

          <div class="bBody">
            <div class="barWrap">
              <div class="barLabel"><span>Progress</span><span>${pct}%</span></div>
              <div class="bar"><div class="barFill" style="width:${pct}%"></div></div>
            </div>
            ${costHtml}
          </div>
        `;

        const doUpgrade = () => {
          const cur = clampInt(state.buildings[b.key], 1, MAX_LEVEL);
          if(cur >= MAX_LEVEL){ showToast(`${b.name} is max (${MAX_LEVEL}).`); return; }
          const c = nextUpgradeCost(b.key, cur);
          if(!canAfford(c)){ showToast(`Need ${c.gold}g and ${c.wood}w for ${b.name}.`); return; }

          spend(c);
          state.buildings[b.key] = cur + 1;

          const eff = derivedEffects();
          state.timers.climbElapsed = Math.min(state.timers.climbElapsed, eff.climbSec * 1000 - 1);
          state.timers.lootElapsed = Math.min(state.timers.lootElapsed, eff.lootSec * 1000 - 1);
          state.timers.gatherElapsed = Math.min(state.timers.gatherElapsed, eff.gatherSec * 1000 - 1);

          saveState();
          updateResourceUI();
          updateDerivedTimersAndGainsUI();
          renderBuildings();
          showToast(`${b.name} upgraded to Lvl ${state.buildings[b.key]}! (-${c.gold}g, -${c.wood}w)`);
        };

        card.addEventListener("click", doUpgrade);
        card.addEventListener("keydown", (e) => {
          if(e.key === "Enter" || e.key === " "){
            e.preventDefault();
            doUpgrade();
          }
        });

        buildGridEl.appendChild(card);
      }

      totalLevelsEl.textContent = String(total);
    }

    // ---------- TIMER LOOP ----------
    function setBar(barEl, elapsedMs, periodSec){
      const periodMs = periodSec * 1000;
      const pct = periodMs <= 0 ? 0 : Math.min(100, (elapsedMs / periodMs) * 100);
      barEl.style.width = pct + "%";
    }

    function tickFrame(nowMs){
      const eff = derivedEffects();

      const last = Number(state.lastFrameMs || nowMs);
      let dt = nowMs - last;
      if(dt < 0) dt = 0;
      if(dt > 2000) dt = 2000;
      state.lastFrameMs = nowMs;

      state.timers.climbElapsed += dt;
      state.timers.lootElapsed += dt;
      state.timers.gatherElapsed += dt;

      const climbMs = eff.climbSec * 1000;
      const lootMs = eff.lootSec * 1000;
      const gatherMs = eff.gatherSec * 1000;

      if(climbMs > 0){
        while(state.timers.climbElapsed >= climbMs){
          state.timers.climbElapsed -= climbMs;
          if(doClimb()){
            // New climb cycle begins -> new enemy
            setNewEnemy();
            updateResourceUI();
            const e = ENEMIES[state.currentEnemy];
            showToast(`Climbed! Highest climbed is now ${state.highestClimbed}. Next foe: ${e ? e.name : "???"}.`);
          }
        }
      }

      if(lootMs > 0){
        let lootTotal = 0, events = 0;
        while(state.timers.lootElapsed >= lootMs){
          state.timers.lootElapsed -= lootMs;
          const g = payoutLoot();
          if(g > 0){ lootTotal += g; events++; }
        }
        if(events > 0){
          updateResourceUI();
          showToast(`Loot payout: +${lootTotal}g.`);
        }
      }

      if(gatherMs > 0){
        let gatherTotal = 0, events = 0;
        while(state.timers.gatherElapsed >= gatherMs){
          state.timers.gatherElapsed -= gatherMs;
          const w = payoutGather();
          if(w > 0){ gatherTotal += w; events++; }
        }
        if(events > 0){
          updateResourceUI();
          showToast(`Gather payout: +${gatherTotal}w.`);
        }
      }

      setBar(climbBarEl, state.timers.climbElapsed, eff.climbSec);
      setBar(lootBarEl, state.timers.lootElapsed, eff.lootSec);
      setBar(gatherBarEl, state.timers.gatherElapsed, eff.gatherSec);

      tickFrame._saveAccum = (tickFrame._saveAccum || 0) + dt;
      if(tickFrame._saveAccum >= 1000){
        tickFrame._saveAccum = 0;
        saveState();
        renderBuildings();
      }

      requestAnimationFrame(tickFrame);
    }

    // ---------- TALENTS (STATIC TREE) ----------
    function talentIcon(kind){
      const m = {
        sword: `<path d="M18 6l-7 7" /><path d="M11 13l-5 5" /><path d="M8 18l-2 1 1-2" /><path d="M13 5l2 2" opacity=".65"/>`,
        leaf: `<path d="M7 17c6-1 10-5 10-11-6 0-10 4-11 10" /><path d="M6 18c2-2 6-6 11-11" opacity=".6"/>`,
        star: `<path d="M12 3l2.2 5.2L20 10l-5.8 1.8L12 17l-2.2-5.2L4 10l5.8-1.8z"/>`,
        shield:`<path d="M12 3l8 4v6c0 5-4 8-8 8s-8-3-8-8V7z" /><path d="M12 6v13" opacity=".55"/>`,
        flask:`<path d="M10 2h4"/><path d="M12 2v6l5 8a4 4 0 01-3.4 6H10.4A4 4 0 017 16l5-8"/><path d="M9 14h6" opacity=".55"/>`,
        bolt:`<path d="M13 2L5 14h7l-1 8 8-12h-7z"/>`,
        eye: `<path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6-10-6-10-6z"/><path d="M12 10a2 2 0 100 4 2 2 0 000-4z" opacity=".65"/>`,
      };
      return m[kind] || m.star;
    }

    function renderTalentTree(){
      const svg = document.getElementById("talentSvg");

      const nodes = [
        { id:"n1", x:140, y:90,  kind:"star" },
        { id:"n2", x:500, y:90,  kind:"eye" },
        { id:"n3", x:860, y:90,  kind:"bolt" },
        { id:"n4", x:250, y:210, kind:"sword" },
        { id:"n5", x:500, y:230, kind:"shield" },
        { id:"n6", x:750, y:210, kind:"flask" },
        { id:"n7", x:170, y:360, kind:"leaf" },
        { id:"n8", x:500, y:360, kind:"star" },
        { id:"n9", x:830, y:360, kind:"leaf" },
        { id:"n10", x:320, y:500, kind:"shield" },
        { id:"n11", x:680, y:500, kind:"sword" },
      ];

      const edges = [
        ["n1","n4"], ["n2","n5"], ["n3","n6"],
        ["n4","n7"], ["n4","n8"],
        ["n5","n8"],
        ["n6","n8"], ["n6","n9"],
        ["n7","n10"], ["n8","n10"], ["n8","n11"], ["n9","n11"]
      ];

      const nodeById = Object.fromEntries(nodes.map(n => [n.id, n]));

      function edgePath(a, b){
        const ax = a.x, ay = a.y;
        const bx = b.x, by = b.y;
        const midY = (ay + by) / 2;
        return `M ${ax} ${ay} C ${ax} ${midY}, ${bx} ${midY}, ${bx} ${by}`;
      }

      const bg = `
        <defs>
          <radialGradient id="glow" cx="50%" cy="35%" r="70%">
            <stop offset="0%" stop-color="rgba(124,196,255,0.30)"/>
            <stop offset="55%" stop-color="rgba(124,196,255,0.08)"/>
            <stop offset="100%" stop-color="rgba(0,0,0,0)"/>
          </radialGradient>

          <linearGradient id="edgeGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="rgba(124,196,255,0.55)"/>
            <stop offset="100%" stop-color="rgba(255,255,255,0.10)"/>
          </linearGradient>

          <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="10" stdDeviation="10" flood-color="rgba(0,0,0,.55)"/>
          </filter>
        </defs>

        <rect x="0" y="0" width="1000" height="600" fill="rgba(0,0,0,0)"/>
        <circle cx="320" cy="120" r="220" fill="url(#glow)" opacity="0.7"/>
        <circle cx="760" cy="210" r="260" fill="url(#glow)" opacity="0.55"/>
      `;

      const edgeSvg = edges.map(([from,to]) => {
        const a = nodeById[from], b = nodeById[to];
        return `<path d="${edgePath(a,b)}" fill="none" stroke="url(#edgeGrad)" stroke-width="4" opacity="0.55"/>`;
      }).join("");

      const nodeSvg = nodes.map(n => {
        const r = 42;
        const icon = `
          <g transform="translate(${n.x-14},${n.y-14})" opacity="0.95">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                 xmlns="http://www.w3.org/2000/svg" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              ${talentIcon(n.kind)}
            </svg>
          </g>
        `;
        return `
          <g filter="url(#softShadow)">
            <circle cx="${n.x}" cy="${n.y}" r="${r}" fill="rgba(0,0,0,.28)" stroke="rgba(255,255,255,.16)" stroke-width="2"/>
            <circle cx="${n.x}" cy="${n.y}" r="${r-10}" fill="rgba(124,196,255,.08)" stroke="rgba(124,196,255,.22)" stroke-width="2"/>
            ${icon}
          </g>
        `;
      }).join("");

      svg.innerHTML = bg + edgeSvg + nodeSvg;
    }

    // ---------- RESET ----------
    resetBtn.addEventListener("click", () => {
      state = defaultState();
      saveState();
      updateResourceUI();
      updateDerivedTimersAndGainsUI();
      renderBuildings();
      renderTalentTree();
      setActiveTab(state.activeRightTab);
      enforceSingleClimb();
      updateRowBadges();
      showToast("Reset done: everything set back to defaults.");
    });

    // ---------- INIT ----------
    updateResourceUI();
    updateDerivedTimersAndGainsUI();
    renderBuildings();
    renderTalentTree();
    setActiveTab(state.activeRightTab);
    enforceSingleClimb();
    updateRowBadges();
    requestAnimationFrame(tickFrame);
  </script>
</body>
