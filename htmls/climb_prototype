    // ---------- DERIVED EFFECTS ----------
    const BASE = { climbSec: 60, lootSec: 15, gatherSec: 15 };

    function derivedEffects(){
      const lv = (k) => clampInt(state.buildings[k], 1, MAX_LEVEL);

      const climbSpeedLv = (lv("smithy") - 1) + (lv("alchemist") - 1) + (lv("armorCrafter") - 1);
      const climbSec = Math.max(5, BASE.climbSec - climbSpeedLv);

      const gatherSpeedLv = (lv("druidCircle") - 1);
      const gatherSec = Math.max(5, BASE.gatherSec - gatherSpeedLv);

      const lootSpeedLv = (lv("mageGuild") - 1);
      const lootSec = Math.max(5, BASE.lootSec - lootSpeedLv);

      const tavernMult = 1 + 0.05 * (lv("tavern") - 1);
      const guildMult  = 1 + 0.05 * (lv("guildHall") - 1);
      const gainMult = tavernMult * guildMult;

      return { climbSec, lootSec, gatherSec, gainMult };
    }

