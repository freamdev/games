    function spend(cost){
      state.resources.gold -= cost.gold;
      state.resources.wood -= cost.wood;
      if(state.resources.gold < 0) state.resources.gold = 0;
      if(state.resources.wood < 0) state.resources.wood = 0;
    }

    function payoutLoot(){
      const eff = derivedEffects();
      const actions = getRowActions();
      const lvlFactor = Math.max(1, state.highestClimbed - 1);

      let groupsLooting = 0;
      for(const r of actions) if(r.action === "loot") groupsLooting++;
      if(groupsLooting <= 0) return 0;

      const basePerGroup = lvlFactor * 10;
      const totalGold = Math.round(basePerGroup * groupsLooting * eff.gainMult);
      state.resources.gold = clampInt(state.resources.gold + totalGold, 0, 999999999);
      return totalGold;
    }

    function payoutGather(){
      const eff = derivedEffects();
      const actions = getRowActions();
      const lvlFactor = Math.max(1, state.highestClimbed - 1);

      let groupsGathering = 0;
      for(const r of actions) if(r.action === "gather") groupsGathering++;
      if(groupsGathering <= 0) return 0;

      const basePerGroup = lvlFactor * 5;
      const totalWood = Math.round(basePerGroup * groupsGathering * eff.gainMult);
      state.resources.wood = clampInt(state.resources.wood + totalWood, 0, 999999999);
      return totalWood;
    }

    function doClimb(){
